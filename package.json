{
  "name": "pf-itemcalc",
  "homepage": "https://pf-itemcalc.github.io/pf-itemcalc",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "predeploy": "npm version patch && npm run build",
    "deploy": "gh-pages -d build",
    "tsc": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --check --write",
    "check": "tsc -b && eslint . && prettier . --check",
    "fix": "tsc -b && eslint . --fix && prettier . --check --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "lodash": "^4.18.1",
    "match-sorter": "^8.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-window": "^2.2.7",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.1",
    "prettier": "3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
